{
  "functions": {
    "api/mcp.ts": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/", "destination": "/landing", "permanent": false }
  ],
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "has": [{ "type": "host", "value": "mcp.confinamais.com" }], "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/:caminho*", "has": [{ "type": "host", "value": "mcp.confinamais.com" }], "destination": "/api/oauth-protected-resource" },
    { "source": "/mcp", "has": [{ "type": "host", "value": "mcp.confinamais.com" }], "destination": "/api/mcp" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
